   "source": [
    "# Binary Search\n",
    "nums = [2, 54, 21, 32, 5]\n",
    "nums.sort()\n",
    "print(\"Enter the sorted array elements:\", \" \".join(map(str, nums)))\n",
    "target = 21\n",
    "print(f\"Enter the element to search: {target}\")\n",
    "idx = nums.index(target) if target in nums else -1\n",
    "print(f\"Element found at index {idx}.\")"
   ]
  }
