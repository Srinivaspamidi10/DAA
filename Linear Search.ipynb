    "# Linear Search\n",
    "arr = [5, 32, 1, 34, 3]\n",
    "print(\"Enter the array elements:\", \" \".join(map(str, arr)))\n",
    "target = 34\n",
    "print(f\"Enter the element to search: {target}\")\n",
    "idx = arr.index(target)\n",
    "print(f\"Element found at index {idx}.\")"
